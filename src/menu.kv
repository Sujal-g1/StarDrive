#:import dp kivy.metrics.dp

<ModernButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    border: 0, 0, 0, 0
    color: 0.78, 0.94, 1, 1
    font_name: 'Eurostile.ttf'
    font_size: dp(12)
    bold: False
    canvas.before:
        Color:
            rgba: (0.02, 0.13, 0.19, 0.94) if self.state == 'normal' else (0.04, 0.30, 0.40, 0.98)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(4), dp(4), dp(4), dp(4)]

        Color:
            rgba: 0.05, 0.72, 0.95, 0.75
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(4)
            width: 1.0

        Color:
            rgba: 0.15, 0.85, 1, 0.9
        Rectangle:
            pos: self.x + dp(1), self.top - dp(2)
            size: self.width - dp(2), dp(1)


<Menu>:
    size_hint: 1, 1

    canvas.before:
        # Full-screen menu dimmer: game remains visible but cannot overpower UI.
        Color:
            rgba: 0.002, 0.006, 0.012, 0.965
        Rectangle:
            pos: self.pos
            size: self.size

        # Main panel
        Color:
            rgba: 0.004, 0.018, 0.028, 0.985
        RoundedRectangle:
            pos: self.center_x - dp(440), self.center_y - dp(260)
            size: dp(880), dp(520)
            radius: [dp(12), dp(12), dp(12), dp(12)]

        Color:
            rgba: 0.04, 0.65, 0.85, 0.75
        Line:
            rounded_rectangle: self.center_x - dp(440), self.center_y - dp(260), dp(880), dp(520), dp(12)
            width: 1.1

        Color:
            rgba: 0.05, 0.75, 1, 0.8
        Line:
            points: self.center_x - dp(420), self.center_y + dp(220), self.center_x - dp(385), self.center_y + dp(220)
            width: 2
        Line:
            points: self.center_x - dp(420), self.center_y + dp(220), self.center_x - dp(420), self.center_y + dp(185)
            width: 2
        Line:
            points: self.center_x + dp(420), self.center_y + dp(220), self.center_x + dp(385), self.center_y + dp(220)
            width: 2
        Line:
            points: self.center_x + dp(420), self.center_y + dp(220), self.center_x + dp(420), self.center_y + dp(185)
            width: 2

        Color:
            rgba: 0.04, 0.55, 0.72, 0.42
        Rectangle:
            pos: self.center_x - dp(385), self.center_y - dp(155)
            size: dp(770), dp(1)

    Label:
        text: 'DEEP SPACE // RACING DIVISION'
        font_name: 'Eurostile.ttf'
        font_size: dp(9)
        color: 0.20, 0.70, 0.85, 0.85
        size_hint: None, None
        size: dp(500), dp(24)
        pos_hint: {'center_x': 0.5, 'center_y': 0.79}
        halign: 'center'
        valign: 'middle'
        text_size: self.size

    Label:
        text: root.parent.menu_title
        font_name: 'Sackers-Gothic-Std-Light.ttf'
        font_size: dp(45)
        color: 0.82, 0.95, 1, 1
        size_hint: None, None
        size: dp(760), dp(75)
        pos_hint: {'center_x': 0.5, 'center_y': 0.66}
        halign: 'center'
        valign: 'middle'
        text_size: self.size

    Label:
        text: 'SPACE RACING EXPERIENCE'
        font_name: 'Eurostile.ttf'
        font_size: dp(9)
        color: 0.38, 0.65, 0.74, 0.9
        size_hint: None, None
        size: dp(500), dp(25)
        pos_hint: {'center_x': 0.5, 'center_y': 0.56}
        halign: 'center'
        valign: 'middle'
        text_size: self.size

    ModernButton:
        text: root.parent.menu_button_title
        size_hint: None, None
        size: dp(360), dp(58)
        pos_hint: {'center_x': 0.5, 'center_y': 0.42}
        on_release: root.parent.on_menu_button()

    ModernButton:
        text: root.parent.menu_modes_title
        size_hint: None, None
        size: dp(360), dp(52)
        pos_hint: {'center_x': 0.5, 'center_y': 0.30}
        on_release: root.parent.on_menu_modes()

    Label:
        text: 'SECTOR 01'
        font_name: 'Eurostile.ttf'
        font_size: dp(8)
        color: 0.25, 0.55, 0.65, 0.85
        size_hint: None, None
        size: dp(120), dp(20)
        pos_hint: {'x': 0.075, 'y': 0.09}
        halign: 'left'
        valign: 'middle'
        text_size: self.size

    Label:
        text: 'PILOT READY'
        font_name: 'Eurostile.ttf'
        font_size: dp(8)
        color: 0.20, 0.85, 0.60, 0.88
        size_hint: None, None
        size: dp(150), dp(20)
        pos_hint: {'center_x': 0.5, 'y': 0.09}
        halign: 'center'
        valign: 'middle'
        text_size: self.size

    Label:
        text: 'SYSTEM // 100%'
        font_name: 'Eurostile.ttf'
        font_size: dp(8)
        color: 0.25, 0.55, 0.65, 0.85
        size_hint: None, None
        size: dp(150), dp(20)
        pos_hint: {'right': 0.925, 'y': 0.09}
        halign: 'right'
        valign: 'middle'
        text_size: self.size
