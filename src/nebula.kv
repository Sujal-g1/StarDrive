#:import dp kivy.metrics.dp
#:import menu menu
#:import modes modes

<HUDOverlay@Widget>:
    canvas:
        Color:
            rgba: 0.05, 0.75, 1, 0.55

        Line:
            points: self.x + dp(28), self.top - dp(52), self.right - dp(28), self.top - dp(52)
            width: 1.0

        Line:
            points: self.x + dp(28), self.top - dp(52), self.x + dp(28), self.top - dp(82)
            width: 1.0

        Line:
            points: self.x + dp(28), self.top - dp(82), self.x + dp(58), self.top - dp(82)
            width: 1.0

        Line:
            points: self.right - dp(28), self.top - dp(52), self.right - dp(28), self.top - dp(82)
            width: 1.0

        Line:
            points: self.right - dp(28), self.top - dp(82), self.right - dp(58), self.top - dp(82)
            width: 1.0

        Color:
            rgba: 0.05, 0.75, 1, 0.25

        Line:
            circle: self.center_x, self.center_y, dp(34)
            width: 0.8

        Line:
            circle: self.center_x, self.center_y, dp(52)
            width: 0.6

        Color:
            rgba: 0.05, 0.75, 1, 0.48

        Line:
            points: self.center_x - dp(70), self.center_y, self.center_x - dp(18), self.center_y
            width: 0.8

        Line:
            points: self.center_x + dp(18), self.center_y, self.center_x + dp(70), self.center_y
            width: 0.8

        Line:
            points: self.center_x, self.center_y - dp(70), self.center_x, self.center_y - dp(18)
            width: 0.8

        Line:
            points: self.center_x, self.center_y + dp(18), self.center_x, self.center_y + dp(70)
            width: 0.8

        Color:
            rgba: 0.05, 0.75, 1, 0.30

        Line:
            points: self.x + dp(28), self.y + dp(42), self.right - dp(28), self.y + dp(42)
            width: 1.0


<MainWidget>:
    canvas.before:
        Rectangle:
            source: "space9.jpeg"
            pos: self.pos
            size: self.size

        Color:
            rgba: 0.002, 0.008, 0.018, 0.52

        Rectangle:
            pos: self.pos
            size: self.size

    # GAME HUD
    Label:
        text: "STAR DRIVE"
        font_name: "Eurostile.ttf"
        font_size: dp(14)
        color: 0.25, 0.85, 1, 0.92
        size_hint: None, None
        size: dp(180), dp(28)
        pos_hint: {'x': 0.035, 'top': 0.965}
        halign: 'left'
        valign: 'middle'
        text_size: self.size

    Label:
        text: "SECTOR // 07"
        font_name: "Eurostile.ttf"
        font_size: dp(8)
        color: 0.45, 0.70, 0.80, 0.75
        size_hint: None, None
        size: dp(180), dp(22)
        pos_hint: {'x': 0.035, 'top': 0.925}
        halign: 'left'
        valign: 'middle'
        text_size: self.size

    Label:
        text: root.score_label
        font_name: "Eurostile.ttf"
        font_size: dp(12)
        color: 0.90, 0.97, 1, 0.92
        size_hint: None, None
        size: dp(190), dp(28)
        pos_hint: {'x': 0.035, 'top': 0.885}
        halign: 'left'
        valign: 'middle'
        text_size: self.size

    Label:
        text: root.best_score_label
        font_name: "Eurostile.ttf"
        font_size: dp(9)
        color: 0.30, 0.65, 0.78, 0.80
        size_hint: None, None
        size: dp(190), dp(22)
        pos_hint: {'x': 0.035, 'top': 0.85}
        halign: 'left'
        valign: 'middle'
        text_size: self.size

    # RIGHT TELEMETRY
    Label:
        text: "SYSTEM"
        font_name: "Eurostile.ttf"
        font_size: dp(8)
        color: 0.40, 0.68, 0.78, 0.75
        size_hint: None, None
        size: dp(150), dp(20)
        pos_hint: {'right': 0.965, 'top': 0.965}
        halign: 'right'
        valign: 'middle'
        text_size: self.size

    Label:
        text: "ONLINE"
        font_name: "Eurostile.ttf"
        font_size: dp(10)
        color: 0.20, 1, 0.65, 0.92
        size_hint: None, None
        size: dp(150), dp(24)
        pos_hint: {'right': 0.965, 'top': 0.93}
        halign: 'right'
        valign: 'middle'
        text_size: self.size

    Label:
        text: "DRIVE // ACTIVE"
        font_name: "Eurostile.ttf"
        font_size: dp(8)
        color: 0.45, 0.70, 0.80, 0.78
        size_hint: None, None
        size: dp(180), dp(22)
        pos_hint: {'right': 0.965, 'top': 0.895}
        halign: 'right'
        valign: 'middle'
        text_size: self.size

    HUDOverlay:
        size: self.size
        pos: self.pos

    # MENU / MODES
    Menu:
        id: menu_widget
        opacity: 1
        size: self.size
        pos: self.pos

    Modes:
        id: modes_widget
        opacity: 0
        size: self.size
        pos: self.pos
